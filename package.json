{
  "name": "@hexlet/code",
  "version": "1.0.0",
  "description": "Form generator on TypeScript",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "oxlint && oxfmt --check",
    "lint-fix": "oxfmt && oxlint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test-coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wswfws/react-urfu-project-81.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/wswfws/react-urfu-project-81/issues"
  },
  "homepage": "https://github.com/wswfws/react-urfu-project-81#readme",
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
